\]

\[
=\frac{P\big((A\cap V)\cup(T\cap V)\big)}{P(V)}
\]

\[
=\frac{P(A\cap V)+P(T\cap V)}{P(V)}
\]

\[
=\frac{P(A)\cdot P(V|A)+P(T)\cdot P(V|T)}{P(V)}
\]

\[
=\frac{0.3\cdot0.6+0.1\cdot1}{0.565}
